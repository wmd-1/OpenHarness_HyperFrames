# ============================================================================
# OpenHarness 环境变量配置
# ============================================================================
# 使用方法：复制本文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================================================

# ---- LLM API Keys（至少配置一个）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 可选 API Keys ----
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=

# ---- QwenTTS (本地 TTS 服务，Base 声音克隆) ----
# 设置 QWENTTS_URL 后自动启用 qwentts provider（优先级最高）；服务需 serve
# Qwen/Qwen3-TTS-12Hz-1.7B-Base（无预置音色），合成经克隆脚本 qwen3_tts_clone.py，
# 必须同时配置参考音频 + 转写文本（缺失则报错，不静默回退）。
# QWENTTS_URL=http://localhost:8091
# QWENTTS_REF_AUDIO_HOST_DIR=./assets/tts-ref   # 宿主机参考音频目录，挂载到容器 /opt/tts-ref
# QWENTTS_REF_AUDIO=/opt/tts-ref/reference.wav  # 容器内路径，wav/mp3/flac/ogg，1~30 秒
# QWENTTS_REF_TEXT=参考音频的转写文本
# QWENTTS_VOICE=                # 可选：显式音色名（默认按音频内容 hash 自动生成 clone_<sha1>）
# QWENTTS_CLONE_SCRIPT=         # 可选：克隆脚本路径（默认 /opt/qwen3-tts-script/qwen3_tts_clone.py）

# ---- QwenASR (远端 GPU 转写服务，词级时间戳) ----
# 设置 QWENASR_URL 后自动启用 qwenasr 引擎（转写链路最高优先级）；远端服务需按
# Qwen3-ASR-Script/README.md 部署（FastAPI wrapper + Qwen3-ASR + ForcedAligner）。
# 服务不可达或无词级时间戳时自动回退本地引擎（parakeet / whisperx / whisper.cpp）。
# QWENASR_URL=http://<remote-gpu-host>:8092
# QWENASR_MODEL=                # 可选：请求携带的模型名（默认由服务端决定，Qwen/Qwen3-ASR-1.7B）
# QWENASR_TRANSCRIBE_PATH=      # 可选：转写接口路径（默认 /transcribe）
# QWENASR_TIMEOUT_MS=           # 可选：请求超时毫秒（默认 600000，长音频建议调大）

# ---- 镜像版本标签 ----
OH_VERSION_HYPERFRAMES_VERSION=v0.1.9_v0.7.77_v1.5_v2.1
# session-frontend 镜像 tag（与 session-frontend/package.json 的 version 同步 bump，
# 构建新镜像时两处一起改；未设时 compose 回退 v0.1.0）
# SESSION_FRONTEND_VERSION=v0.1.0

# ---- Session oh 后端二进制（session-acceptance-hardening P1-2）----
# 语义：单一可执行文件路径（作为子进程 argv[0]），不支持带参数的 command；
# 需要附加参数/解释器时请写可执行 wrapper 脚本。启动时三条校验（无空白/
# 存在且为普通文件/可执行），process 运行时不通过则 fail-fast。
# stub 测试模式不要在这里改值，用 override 文件固化（避免配置漂移）：
#   docker compose -f docker-compose.yml -f docker-compose.stub.yml up -d session
# OH_OH_BIN=/root/.local/bin/oh

# ---- Session 服务鉴权（session-tenant-isolation, WS-A）----
# 默认「开放模式」：不设 OH_API_KEY 且 OH_REQUIRE_AUTH=false 时任意请求放行，
# 仅适合本机/内网可信环境或 e2e。生产部署务必启用鉴权：
#   1) 设置 OH_API_KEY 为强随机值（单 key，恒时比较）；
#   2) 设 OH_REQUIRE_AUTH=true 强制校验（未设 key 时启动即失败，fail-fast）。
# 启用后前端需在侧栏「API Key」卡片填入同一 key（见文末说明）。
# OH_API_KEY=
# OH_REQUIRE_AUTH=false

# ---- MinIO（session 多租户数据权威源，WS-B）----
# compose 内置 minio 服务默认凭据如下；生产部署务必改为强凭据。
# OH_MINIO_ACCESS_KEY=ohminio
# OH_MINIO_SECRET_KEY=ohminio-secret
# OH_MINIO_BUCKET=oh-tenants
# 多 key 租户认证（WS-A）：key 吊销生效延迟≤缓存 TTL（秒）
# OH_APIKEY_CACHE_TTL=60

# ---- Session workspace 归档（session-workspace-archive）----
# 会话工作目录随 turn/驱逐/close 增量归档到 MinIO（复用上方 OH_MINIO_*，
# 未配 OH_MINIO_ENDPOINT 时整体 no-op）。以下均为默认值，按需覆盖：
# OH_WORKSPACE_SYNC_IGNORE=node_modules,.venv,__pycache__,.git,.cache,tmp
# OH_WORKSPACE_SYNC_MAX_FILE_MB=512
# OH_WORKSPACE_SYNC_MAX_TOTAL_MB=2048
# OH_WORKSPACE_SYNC_DEBOUNCE_MS=500
# OH_WORKSPACE_TOMBSTONE_RETENTION_DAYS=7

# ---- 视频服务 MinIO 权威存储（video-service WS-C）----
# api 服务默认 OH_STORAGE_KIND=s3（产物存 MinIO，key 带租户前缀）；
# 设为 local 可回退共享卷旧拓扑。凭据/bucket 复用上方 OH_MINIO_*。
# OH_STORAGE_KIND=s3
# 公网可达的 MinIO 地址（运维部署期提供，如 https://minio.example.com）：
# 配置后下载端点 302 到 presigned URL；未配置时自动流式兜底（不发内网 302）。
# OH_S3_PUBLIC_ENDPOINT=

# ---- 构建参数（通常不需要修改）----
# PYTHON_VERSION=3.11
# UV_VERSION=0.7.3

# ---- 前端 API Key（浏览器端 localStorage，非本文件配置）----
# 仅当部署端设置了上方 API_KEY（启用 X-API-Key 鉴权）时需要：
# 访问前端页面，在侧栏「API Key」卡片填入该 Key 并保存。
# 前端会自动为请求携带 X-API-Key（SSE / 文件通过 ?api_key= 参数）。
