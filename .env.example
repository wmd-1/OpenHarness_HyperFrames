# ============================================================================
# OpenHarness 环境变量配置
# ============================================================================
# 使用方法：复制本文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================================================

# ---- LLM API Keys（至少配置一个）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 可选 API Keys ----
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=

# ---- QwenTTS (本地 TTS 服务，Base 声音克隆) ----
# 设置 QWENTTS_URL 后自动启用 qwentts provider（优先级最高）；服务需 serve
# Qwen/Qwen3-TTS-12Hz-1.7B-Base（无预置音色），合成经克隆脚本 qwen3_tts_clone.py，
# 必须同时配置参考音频 + 转写文本（缺失则报错，不静默回退）。
# QWENTTS_URL=http://localhost:8091
# QWENTTS_REF_AUDIO_HOST_DIR=./assets/tts-ref   # 宿主机参考音频目录，挂载到容器 /opt/tts-ref
# QWENTTS_REF_AUDIO=/opt/tts-ref/reference.wav  # 容器内路径，wav/mp3/flac/ogg，1~30 秒
# QWENTTS_REF_TEXT=参考音频的转写文本
# QWENTTS_VOICE=                # 可选：显式音色名（默认按音频内容 hash 自动生成 clone_<sha1>）
# QWENTTS_CLONE_SCRIPT=         # 可选：克隆脚本路径（默认 /opt/qwen3-tts-script/qwen3_tts_clone.py）

# ---- 镜像版本标签 ----
OH_VERSION_HYPERFRAMES_VERSION=v0.1.9_v0.7.77_v1.4_v2.1

# ---- 构建参数（通常不需要修改）----
# PYTHON_VERSION=3.11
# UV_VERSION=0.7.3

# ---- 前端 API Key（浏览器端 localStorage，非本文件配置）----
# 仅当部署端设置了上方 API_KEY（启用 X-API-Key 鉴权）时需要：
# 访问前端页面，在侧栏「API Key」卡片填入该 Key 并保存。
# 前端会自动为请求携带 X-API-Key（SSE / 文件通过 ?api_key= 参数）。
